# Resend: the From address must be on a domain verified in Resend (not @gmail.com).
# Leads go to QUOTE_TO_EMAIL (comma-separate for several); customer replies go there too.
RESEND_API_KEY=
QUOTE_TO_EMAIL=capitaldrywallandrenovations@gmail.com
QUOTE_FROM_EMAIL=Capital Drywall & Renovation <quotes@capitaldrywallrenovations.com>
# Resend webhook signing secret (whsec_…), for delivery status in the lead log: /api/resend-webhook
RESEND_WEBHOOK_SECRET=
# Tekmadev lead log (Supabase): project URL, publishable key (sb_publishable_…), and this site's
# own secret (its sha256 is in public.client_websites). No contact details are ever sent.
LEAD_LOG_URL=
LEAD_LOG_API_KEY=
LEAD_LOG_SECRET=
BLOB_READ_WRITE_TOKEN=
LEAD_WEBHOOK_URL=
BOOKING_URL=
NEXT_PUBLIC_SITE_URL=https://capitaldrywallrenovations.com
NEXT_PUBLIC_SITE_MODE=demo   # demo | production
NEXT_PUBLIC_GA_ID=
